{
    "expo": {
      "name": "PathFinder",
      "slug": "pathfinder-app",
      "version": "1.0.0",
      "orientation": "portrait",
      "icon": "./assets/icon.png",
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      },
      "platforms": ["ios", "android", "web"],
      "ios": {
        "supportsTablet": true,
        "bundleIdentifier": "com.pathfinder.app",
        "buildNumber": "1"
      },
      "android": {
        "adaptiveIcon": {
          "foregroundImage": "./assets/adaptive-icon.png",
          "backgroundColor": "#FFFFFF"
        }
      },
      "web": {
        "favicon": "./assets/favicon.png"
      },
      "extra": {
        "eas": {
          "build": {
            "variables": {}
          }
        }
      }
    }
  }
